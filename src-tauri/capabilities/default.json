{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "opener:default",
        "store:default",
        "core:window:default",
        "core:window:allow-start-dragging",
        "dialog:allow-open",
        "dialog:allow-save",
        "log:default",
        {
            "identifier": "shell:allow-execute",
            "allow": [
                {
                    "name": "ffmpeg",
                    "cmd": "ffmpeg",
                    "args": true
                },
                {
                    "name": "ffprobe",
                    "cmd": "ffprobe",
                    "args": true
                }
            ]
        }
    ]
}